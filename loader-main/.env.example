# Copy to .env and fill in. .env is not in the repository.
#
# The build refuses values that would overrun the strings the injector writes
# them over: the host must be ASCII and at most 45 characters, and the key at
# most 426 bytes once normalised.
DS2OS_SERVER_NAME=Jamuja
DS2OS_SERVER_HOST=127.0.0.1
DS2OS_SERVER_KEY="-----BEGIN RSA PUBLIC KEY-----\n...\n-----END RSA PUBLIC KEY-----\n"
